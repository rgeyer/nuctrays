# sftpgo stack environment variables
# Copy this file to sftpgo/.env and fill in all values.

# Timezone
TZ=America/Your_Timezone

# Hostnames (both resolve to TRAEFIK_PRIVATE_IP on your LAN DNS)
# WebDAV endpoint that ShareX (and other WebDAV clients) talk to:
SFTPGO_WEBDAV_HOST=dav.yourdomain.com
# SFTPGo admin / web client UI:
SFTPGO_ADMIN_HOST=sftpgo.yourdomain.com

# Host paths on TrueNAS. Create these before deploy and chown to 1000:1000.
# Persistent SFTPGo state (SQLite DB, host keys, settings):
SFTPGO_CONFIG_PATH=/mnt/yourpool/yourdataset/sftpgo/config
# User data root. Admin UI carves per-user subdirs under this:
SFTPGO_DATA_PATH=/mnt/yourpool/yourdataset/sftpgo/data

# Docker subnet of the traefik-private network, used so SFTPGo trusts the
# X-Forwarded-* headers Traefik sets (so logs/audit see real client IPs).
# Find with:  docker network inspect traefik-private | grep Subnet
TRAEFIK_PRIVATE_SUBNET=172.x.0.0/16
