# rflib stack environment variables
# Copy this file to rflib/.env and fill in all values.

# Timezone
TZ=America/Your_Timezone

# Private registry holding the rflib image (see README), and the release
# it was built from
REGISTRY_HOST=registry.yourdomain.com
RFLIB_VERSION=v0.1.0

# Hostname for the private and public Traefik instances (same hostname for both)
RFLIB_HOST=rflib.yourdomain.com

# Who may register: invite (a code from rflib user invite), open, or closed
RFLIB_SIGNUP=invite

# Host path holding the library (library.db): the rflib user's home
# directory (getent passwd rflib | cut -d: -f6; see README)
RFLIB_DATA_PATH=/mnt/yourpool/home/rflib

# The rflib user's IDs (id -u rflib, id -g rflib): a dedicated TrueNAS user
# and group (Credentials → Users), so no other app can read the library
RFLIB_UID=3000
RFLIB_GID=3000
